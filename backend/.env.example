# Copy to backend/.env and fill in your own values. Never commit .env.

# PostgreSQL connection (SQLAlchemy URL, psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://trace_user:CHANGE_ME@localhost:5432/trace_db

# Only this origin is allowed by CORS (the Vite dev server)
FRONTEND_ORIGIN=http://localhost:5173

# "development" enables the /api/demo/* endpoints; anything else disables them
APP_ENV=development

# Correlation thresholds (all optional, defaults shown)
FAILED_LOGIN_THRESHOLD=3
FAILED_LOGIN_WINDOW_MINUTES=10
SUCCESS_WINDOW_MINUTES=15
DEVICE_WINDOW_MINUTES=30
ENDPOINT_NETWORK_WINDOW_MINUTES=10
MIN_DEVICE_SEVERITY=Medium

# Used only by the tests (a separate database: tests wipe its tables)
TEST_DATABASE_URL=postgresql+psycopg://trace_user:CHANGE_ME@localhost:5432/trace_test_db

# Base URL of the TRACE FastAPI backend (no trailing slash).
# In development, falls back to http://localhost:8000 when unset.
VITE_API_BASE_URL=http://localhost:8000

# Set to "true" to allow the explicit "Use demo fixtures" fallback in production builds.
# The fallback is always available in `vite dev` and never activates automatically.
VITE_ENABLE_DEMO_FIXTURES=false
